# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Circle Configuration
# Your Circle API Key from the Developer Console (https://console.circle.com)
CIRCLE_API_KEY=TEST_API_KEY:your_circle_api_key

# Circle Gateway API Key (for cross-chain USDC transfers via Gateway)
NEXT_PUBLIC_CIRCLE_GATEWAY_API_KEY=your_circle_gateway_api_key

# ── Privy (WALLET_PROVIDER=privy stack only) ─────────────────────────────────
# App id + secret authenticate the server SDK; the key quorum is the signer
# attached to every wallet at creation so the server can transact without the
# user present. App id and secret: Privy dashboard → your app → Settings →
# Basics (the secret is shown once, at app creation). Key quorum id: Wallets →
# Signers → configure.
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_KEY_QUORUM_ID=your_privy_key_quorum_id
# The quorum's own authorization private key, copied from the same Signers page.
# Every wallet RPC has to be signed with it, so leaving it unset means the server
# can create wallets but not transact with them. Only optional if the quorum has
# no key. The wallet-auth: prefix is stripped for you — paste the value verbatim.
PRIVY_AUTHORIZATION_PRIVATE_KEY=wallet-auth:your_privy_authorization_private_key
# The policy attached to every AGENT wallet at creation. Create your own and get
# its id from `npm run privy:policy -- <per-transaction cap in USDC>`; the cap is
# the script's argument, so do not reuse an id somebody else printed. The agent is
# the one wallet the server spends from with no user in the loop, so the enclave
# refuses a transaction over the cap and lib/autopay.ts's decideAutopay is no
# longer the only thing between the agent and the money. Unset means no policy:
# agent wallets still work, capped only by this server's own judgment. It applies
# at creation, so setting it later leaves existing agent wallets uncapped.
PRIVY_AGENT_POLICY_ID=your_privy_agent_policy_id

# ── Which stack this deployment is ───────────────────────────────────────────
# The wallet backend, and the ONLY switch between the two: `privy` selects the
# Privy variables above, anything else — unset, misspelled, capitalised — selects
# Circle, so a new environment can never silently spend from the stack it was not
# configured for (walletProviderName(), lib/wallet-provider.ts). Leave it unset in
# Production. See docs/deployments.md.
WALLET_PROVIDER=

# Who asks the user to approve a payment — a different question from who holds
# the wallet, and deliberately a separate switch. `privy` puts Privy's own login
# modal on the door and its confirmation prompt in front of every transaction,
# paid from a Privy EMBEDDED wallet the user owns from creation; anything else
# leaves Splitsy's own screens exactly as they are. Same exact-match rule and the
# same OFF default as WALLET_PROVIDER (walletUiName(), lib/wallet-provider.ts).
#
# Only meaningful with WALLET_PROVIDER=privy — an embedded wallet is a Privy
# wallet. The two are kept separate so the popup can be compared against the
# app's own screens and turned off again without touching anybody's custody.
WALLET_UI=

# Whether a user may take sole ownership of a pay wallet Splitsy minted. Unset is
# OFF, and that is a safety rail rather than a preference: a claim is
# irreversible, nobody — including Privy — can recover a forgotten password, and
# a wallet claimed before every spending route understood user signatures works
# less well than the one the user started with. Only the exact string `true`
# turns it on (claimEnabled(), lib/wallet-gate.ts). Irrelevant when
# WALLET_UI=privy: an embedded wallet is already the user's and has nothing to
# claim. See docs/deployments.md.
WALLET_CLAIM_ENABLED=

# Banner text shown at the top of every page. Set in Vercel's PREVIEW
# environment ("Privy stack — Arc Testnet") and left UNSET in Production, so
# forgetting it can only ever under-warn a preview visitor, never mislabel the
# live site. A set value is inlined into the build that saw it and frozen there,
# so changing it needs a redeploy; an unset one leaves a live per-request read, so
# an old build is no defence against a mis-scoped label — only its scope is. See
# docs/deployments.md.
NEXT_PUBLIC_STACK_LABEL=

# The escrow that holds an IOU sent to someone who has not signed up yet
# (contracts/HandleEscrow.sol). Unset means the settle rail refuses to send to a
# stranger rather than stranding the money — the same fail-closed default as
# WALLET_PROVIDER. Deposit ids restart at 1 per deployment, so escrow_deposits
# rows are keyed by (escrow_address, deposit_id). The value below is the live Arc
# Testnet deployment, redeployed 2026-09-20 with registry v3 (it superseded
# 0x9820f2889710a2a5190187993c31ff1d4f15efa5, whose deposits are still
# reclaimable by their depositors there). Deploy your own with
# npm run deploy:arc:handle-escrow.
NEXT_PUBLIC_HANDLE_ESCROW_ADDRESS=0xc29b959868828702c37811deba826da48f0e1a6d

# The address whose key signs releases, and the private key itself. IMMUTABLE in
# the deployed contract: it cannot be changed afterwards, only redeployed. A
# stolen key can misdirect a release — and can do it to every deposit the escrow
# currently holds, one signature per id — but it can take nothing the escrow was
# never given, and any depositor can reclaim ahead of it. Treat it as money.
# Keep it out of the browser: it is read only by the server.
ESCROW_ATTESTER_ADDRESS=
ESCROW_ATTESTER_PRIVATE_KEY=

# The private key that signs slot refund attestations. IMMUTABLE in the deployed
# BillSplitRegistry contract: the attester address is set at construction and
# cannot be changed afterwards. A stolen key can authorize refunds for any slot
# on any bill, sending the funds to an arbitrary recipient. Treat it as money.
# Server-only.
REFUND_SLOT_ATTESTER_PRIVATE_KEY=

# Receipt scanning
RECEIPT_SCANNER_API_KEY=your_receipt_scanner_key
RECEIPT_SCANNER_MODEL=receipt-scanner-model
# Scout's third opinion. A 503 from the Gemini API is a property of the MODEL,
# not of the endpoint — the whole gemini-3.x family answers "high demand"
# together while an older or lower-tier model on the same key answers fine. When
# Scout's default model is in a spike it buys one more paid parse from this one
# over the same x402 path, so the receipt the human uploaded still gets read.
SCOUT_FALLBACK_MODEL=gemini-flash-lite-latest
# Scout's second, stricter opinion, used when the first parse comes back unsure.
SCOUT_SECOND_OPINION_MODEL=gemini-3.6-flash

# ── Sign-in providers ─────────────────────────────────────────────────────
# Splitsy supports four sign-in methods. Configure whichever you want to enable;
# each is independent. Google and Email-OTP both resolve to the same email-keyed
# identity (refId "email:<addr>"), so a person who uses either shares one wallet.

# X (Twitter) OAuth 2.0 — Sign in with X (confidential client)
# From the X Developer Portal → your app → Keys and tokens → OAuth 2.0 Client ID and Secret.
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret
# Optional: pin the OAuth redirect origin (defaults to the request origin).
# Must match a Callback URI registered on the X app, e.g. https://splitsy.xyz
# X_OAUTH_REDIRECT_ORIGIN=https://splitsy.xyz

# Discord OAuth 2.0 — Sign in with Discord
# From the Discord Developer Portal → your app → OAuth2. Callback: /api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_oauth2_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret
# DISCORD_OAUTH_REDIRECT_ORIGIN=https://splitsy.xyz

# Google OAuth 2.0 — Sign in with Google
# From the Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URI: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth2_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth2_client_secret
# GOOGLE_OAUTH_REDIRECT_ORIGIN=https://splitsy.xyz

# Email-OTP — Sign in with a one-time code emailed via Resend (https://resend.com)
# EMAIL_FROM must be a verified sender on the Resend account. Requires the
# email_otps table (run schema-otp.sql in Supabase once).
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Splitsy <auth@yourdomain>

# Cloudflare Turnstile — CAPTCHA for email sign-in rate limiting
# Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Session signing secret for the Splitsy login cookie (min 32 chars).
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ── ERC-8004 Payment Reputation ──────────────────────────────────────────────
# Optional: Pinata JWT for uploading agent metadata to IPFS (full ERC-8004 compliance).
# Create a Pinata API key with "pinFileToIPFS" permission at https://app.pinata.cloud
# If not set, registration falls back to data: URIs (reputation still works, just
# without discoverable off-chain metadata).
PINATA_JWT=your_pinata_jwt_token
# Your DEDICATED gateway host, from Pinata's Gateways page. The agent artwork is
# written into the NFT as an https:// URL here rather than ipfs://, because
# explorers resolve ipfs:// via a public gateway and no public gateway can
# retrieve these pins in time (dweb.link and ipfs.io both time out). The shared
# gateway.pinata.cloud works but is rate-limited across every Pinata user.
PINATA_GATEWAY=your-name.mypinata.cloud

# ERC-8004 registries, per network. UNSET MEANS REPUTATION IS OFF — it never
# falls back to another network's registry. Same slot rule as the contracts
# below: unsuffixed is testnet, `_MAINNET` is mainnet.
#
# Both networks have Arc predeploys, and the mainnet pair was verified on chain
# 2026-09-17 against rpc.mainnet.arc.io (chain id 5042): 130 bytes of code at
# each, and IdentityRegistry.name() answers "AgentIdentity".
#
#   testnet  identity   0x8004A818BFB912233c491871b3d84c89A494BD9e
#            reputation 0x8004B663056A597Dffe9eCcC1965A193B7388713
#   mainnet  identity   0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
#            reputation 0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
#
# Deliberately NOT defaulted to those, even though Circle deploys them and not
# us: turning this on mints NFTs and writes feedback from the registrar and
# validator wallets, which on mainnet is real gas from real wallets on the first
# bill anyone pays. Paste them in when those wallets are funded.
#
# Arc mainnet has no ValidationRegistry yet. Nothing here reads one, so it costs
# nothing.
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_IDENTITY_REGISTRY_MAINNET=
ERC8004_REPUTATION_REGISTRY_MAINNET=

# The ERC-8183 job market, same rule (isJobsConfigured(), lib/erc8183.ts:24).
# Unset means autopay runs with no job market — never "settle without the job".
# NEXT_PUBLIC_, so setting it needs a redeploy.
#
# Arc mainnet has NO AgenticCommerce deployment yet, so this stays unset there
# and the job-market half of autopay is off. x402 batching itself now works on
# both networks — @circle-fin/x402-batching 3.5.0 added the Arc mainnet chain —
# so the Settler can buy reviews either way; it is only the job market that is
# missing on mainnet.
NEXT_PUBLIC_AGENTIC_COMMERCE_ADDRESS=

# ── Which Arc network this deployment is on ──────────────────────────────────
# The ONLY switch. `mainnet` selects Arc mainnet (5042); anything else — unset,
# misspelled, capitalised — selects Arc Testnet (5042002), so a new environment
# can never silently spend real money it was not configured for. Same exact-match
# rule and same fail-toward-safety default as WALLET_PROVIDER.
#
# NEXT_PUBLIC_ because the browser needs it too (lib/wagmi.ts, app/PrivyShell.tsx),
# and NEXT_PUBLIC_* is inlined at BUILD time — changing it needs a redeploy, not
# just a saved variable.
#
# Chain id, RPC, explorer, USDC and the Gateway addresses all follow from this one
# value. They are no longer settable one by one, which is what stopped a mainnet
# deployment reading testnet state when a single variable went missing.
NEXT_PUBLIC_ARC_NETWORK=

# Optional RPC override, PER NETWORK. The public endpoints rate-limit, and -32011
# 'request limit reached' surfaces as a failed contract READ — it looks like a
# broken call rather than a quota. The server-only variable wins, so a keyed URL
# need not be published into the browser bundle.
#
# A keyed endpoint belongs to ONE network. Pointing a mainnet build at a testnet
# RPC does not fail — viem does not check — it reads testnet state and labels it
# chain 5042. Hence a separate mainnet slot rather than one shared variable.
ARC_RPC_URL=
NEXT_PUBLIC_ARC_RPC_URL=
ARC_RPC_URL_MAINNET=
NEXT_PUBLIC_ARC_RPC_URL_MAINNET=

# ── Deployed Splitsy contracts, per network ──────────────────────────────────
# One rule for all of these: the UNSUFFIXED variable is the TESTNET slot, and the
# `_MAINNET` twin is the mainnet slot. So both networks can be fully configured
# at once and `NEXT_PUBLIC_ARC_NETWORK` alone decides which set is live — set
# everything up front, flip one variable when you are ready.
#
# Mainnet NEVER falls back to the testnet slot. A `_MAINNET` address left unset
# resolves to the zero address, which every consumer already reads as "not
# configured" and refuses on. That is deliberate: the alternative is quietly
# using a testnet contract address on chain 5042, which is an address with no
# code, and the failure reads as a bug rather than as missing configuration.
#
# These are addresses of deployments, not properties of the chain, so they are
# NOT in lib/arc-chain.ts — they are set here and picked by forArcNetwork().
NEXT_PUBLIC_BILL_SPLIT_REGISTRY_ADDRESS_MAINNET=
NEXT_PUBLIC_RECURRING_TAB_FACTORY_ADDRESS_MAINNET=
NEXT_PUBLIC_HANDLE_ESCROW_ADDRESS_MAINNET=
NEXT_PUBLIC_AUTOPAY_MANDATE_ADDRESS_MAINNET=
# The v1 registry is testnet history; a clean mainnet deployment has none.
BILL_SPLIT_REGISTRY_ADDRESS_V1_MAINNET=

# Splitsy Arc Contract Deployment
DEPLOYER_PRIVATE_KEY=0xyour_funded_arc_testnet_private_key
RECURRING_SETTLER_PRIVATE_KEY=0xyour_funded_arc_testnet_settler_private_key
RECURRING_SETTLER_SECRET=replace_with_a_long_random_bearer_secret
CRON_SECRET=replace_with_the_same_secret_if_your_host_uses_cron_secret

# Settlement agents (autopay + dunning). Both endpoints spend money, so both are
# Bearer-gated; they fall back to CRON_SECRET when this is unset.
AGENT_SECRET=replace_with_a_long_random_bearer_secret
# The previous BillSplitRegistry, kept readable so bill history survives the v2
# redeploy. Bill ids restart at 1 in v2, so an id only means something next to
# the registry it came from.
BILL_SPLIT_REGISTRY_ADDRESS_V1=0xthe_registry_address_you_are_migrating_from
RECURRING_TEST_CYCLE_SECRET=optional_secret_to_show_test_cycle_in_ui
# Current Arc Testnet deployments. Redeploy with npm run deploy:arc:* to get
# your own; these are live and fine to point at for a read-only look around.
# The registry below is v3 (2026-09-20): it carries `settle`, `refundSlot` and an
# immutable attester, none of which the older deployments have. The registry the
# v1 variable above points at is the one this replaced — bill ids restart at 1
# per deployment, so an id only means something next to its own registry.
NEXT_PUBLIC_RECURRING_TAB_FACTORY_ADDRESS=0x9Cc377C957255582BCa8084a950F52e59fB0a41E
NEXT_PUBLIC_BILL_SPLIT_REGISTRY_ADDRESS=0x8e30ca7f7347854629619aec68bd29d7ebedbd48

# Optional: Pimlico ERC-4337 bundler API key for the Circle Paymaster path, which
# lets a browser wallet with no native gas token pay source-chain bridge gas in
# USDC. Just the key — the per-chain URL is built from it. Leave unset to use
# Pimlico's public testnet endpoint (fine for dev). Get a key at dashboard.pimlico.io
NEXT_PUBLIC_PIMLICO_API_KEY=
