ignore-scripts=true
#min-release-age=7
# Both Privy SDKs ship fast and the Privy stack needs current ones; exempt just
# those from the age guard, which still applies to everything else. react-auth is
# here for the same reason node is — 3.42.0 was three days old when it landed, and
# the guard being off today is what let it in at all.
min-release-age-exclude[]=@privy-io/node
min-release-age-exclude[]=@privy-io/react-auth
save-exact=true
audit=true
fund=false
